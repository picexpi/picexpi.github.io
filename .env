# ==============================================================================
# PiDao Backend Configuration
# ==============================================================================

# --- [1] Server Settings ---
PORT=5000
NODE_ENV=production
PUBLIC_API_URL=https://pidao.bonto.run

# --- [2] Security & Authentication ---
# حتماً در محیط واقعی این رشته را با یک عبارت بسیار پیچیده و تصادفی جایگزین کنید
JWT_SECRET=Replace_This_With_A_Very_Long_Random_String_123456789

# کلید API برای ارتباط با سرویس‌های Pi
PI_API_KEY=your_very_secure_api_key_123

# --- [3] Frontend / CORS ---
FRONTEND_URL=https://tiraxturumuz1.github.io
ALLOWED_ORIGINS=https://tiraxturumuz1.github.io,https://apppidaonkm2562.pinet.com,http://localhost:5173,http://localhost:3000

# --- [4] Database Configuration (Docker Network) ---
# طبق فایل docker-compose، نام سرویس دیتابیس شما 'postgres' است.
# این بخش بر اساس سرویس postgres در شبکه pi_network تنظیم شده است.
DATABASE_URL=postgresql://neondb_owner:npg_r4iNwuBljS3c@ep-twilight-cherry-awy2fvts.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Notes:
# - FRONTEND_URL باید آدرس عمومی فرانت‌اند باشد، نه نام سرویس Docker.
# - ALLOWED_ORIGINS برای چند دامنه مجاز استفاده می‌شود.
# - PI_API_KEY باید کلید واقعی Pi باشد.
# - این فایل نباید در GitHub عمومی منتشر شود.
