# ==============================================================================
# PiDao Frontend Configuration - PRODUCTION VERSION
# ==============================================================================

# --- [1] Network & Server Settings ---
VITE_PORT=5000

# Backend API
VITE_API_URL=https://pidao.bonto.run/api

# --- [2] Pi Network App Identity ---
VITE_PI_APP_ID=pidao-pi-2uk8
VITE_PI_CLIENT_ID=c_1Hj75SyO_wbM4BUaxgVzuOmplNnrDj_2pWxDUkD8Q

# --- [3] Pi Network Mode ---
# true  = Testnet / Sandbox
# false = Mainnet
VITE_PI_SANDBOX=true

# --- [4] Payment Settings ---
VITE_DEFAULT_PI_AMOUNT=0.01
VITE_MIN_PI_AMOUNT=0.001
VITE_MAX_PI_AMOUNT=100

# ==============================================================================
# Notes:
# 1. برای تست‌نت مقدار VITE_PI_SANDBOX=true باشد.
# 2. برای مین‌نت مقدار VITE_PI_SANDBOX=false باشد.
# 3. بعد از تغییر هر VITE_ env باید فرانت‌اند دوباره build/deploy شود.
